NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credential for verified provider events and background work.
# Use a Supabase secret key (or legacy service_role key) from your dashboard.
SUPABASE_SECRET_KEY=

# Keep disabled until Route eligibility and seller onboarding are approved.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# At least 32 random characters; protects POST /api/internal/payments/run.
CRON_SECRET=
