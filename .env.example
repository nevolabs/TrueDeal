NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Hosted signup/recovery emails use Gmail SMTP configured in Supabase Auth.
# Set the hosted sender name to TrueDeal. No Gmail password is needed by Next.js.
# For optional LOCAL Supabase Gmail delivery only, see supabase/config.toml:
# GMAIL_SMTP_APP_PASSWORD=

# Server-only migration credentials; never prefix these with NEXT_PUBLIC_.
# This project's IPv4 session pooler avoids direct IPv6 connectivity.
SUPABASE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.fgcgmycoyxrkznskgkpa
SUPABASE_DB_PASSWORD=

# Server-only credential for verified provider events and background work.
# Use a Supabase secret key (or legacy service_role key) from your dashboard.
SUPABASE_SECRET_KEY=

# Keep disabled until Route eligibility and seller onboarding are approved.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# At least 32 random characters; protects POST /api/internal/payments/run.
CRON_SECRET=
